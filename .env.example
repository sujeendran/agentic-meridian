LITELLM_API_KEY=<litellm-proxy-key>
LITELLM_MODEL=claude-sonnet-5
LITELLM_API_BASE=http://127.0.0.1:4000

# Optional: only needed if you swap llm.litellm_model() for llm.databricks_model()
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<personal-access-token>
# DATABRICKS_MODEL=databricks-claude-sonnet-4-6
